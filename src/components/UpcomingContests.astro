---
interface Props {
  dataUrl: string;
}

const { dataUrl } = Astro.props;
---

<section class="section">
  <div class="shell">
    <div class="section-heading">
      <div><span class="eyebrow">04 / UPCOMING</span><h2>近期 Codeforces</h2></div>
      <p>数据由 GitHub Actions 定时更新，时间会按你的本地时区显示。</p>
    </div>
    <div id="contest-board" class="contest-board" data-source={dataUrl} aria-live="polite">
      <p class="mono">正在读取赛程…</p>
    </div>
  </div>
</section>

<script>
  let upcomingRequestController: AbortController | undefined;

  const escapeContestHtml = (value: string) =>
    value.replace(
      /[&<>'"]/g,
      (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char] || char,
    );

  const setupUpcomingContests = () => {
    upcomingRequestController?.abort();
    const board = document.querySelector<HTMLElement>('#contest-board');
    if (!board) return;

    const controller = new AbortController();
    upcomingRequestController = controller;
    fetch(board.dataset.source || '', { signal: controller.signal, cache: 'no-store' })
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('赛程读取失败')))
      .then((items) =>
        items
          .filter((item: { start_time: string }) => new Date(item.start_time).getTime() > Date.now())
          .slice(0, 8),
      )
      .then((items) => {
        if (!items.length) {
          board.innerHTML = '<p class="empty-state">暂时没有已公布的近期比赛，稍后再来看看。</p>';
          return;
        }
        board.innerHTML = items.map(
          (item: { name: string; url: string; platform: string; start_time: string; duration: string }) => {
            const start = new Date(item.start_time);
            return `<article class="contest-row"><div><h3><a href="${encodeURI(item.url)}" target="_blank" rel="noreferrer">${escapeContestHtml(item.name)} ↗</a></h3><p>${escapeContestHtml(item.platform)} · ${escapeContestHtml(item.duration)}</p></div><div class="contest-time">${start.toLocaleDateString('zh-CN')}<br>${start.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}</div></article>`;
          },
        ).join('');
      })
      .catch((error) => {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        board.innerHTML = '<p class="empty-state">赛程暂时无法读取，请稍后重试。</p>';
      });
  };

  document.addEventListener('astro:page-load', setupUpcomingContests);
  document.addEventListener('astro:before-swap', () => upcomingRequestController?.abort());
</script>
