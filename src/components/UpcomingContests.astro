---
import type { UpcomingContest } from '../utils/contest-data';

interface Props {
  contests: UpcomingContest[];
}

const { contests } = Astro.props;
const upcoming = contests
  .filter((contest) => new Date(contest.start_time).getTime() > Date.now())
  .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime())
  .slice(0, 8);
---

<section class="section">
  <div class="shell">
    <div class="section-heading">
      <div><span class="eyebrow">04 / UPCOMING</span><h2>近期 Codeforces</h2></div>
      <p>数据由 GitHub Actions 定时更新，时间会按你的本地时区显示。</p>
    </div>
    <div class="contest-board">
      {upcoming.length === 0 && (
        <p class="empty-state">暂时没有已公布的近期比赛，稍后再来看看。</p>
      )}
      {upcoming.map((contest) => {
        const start = new Date(contest.start_time);
        return (
          <article class="contest-row">
            <div>
              <h3><a href={contest.url} target="_blank" rel="noreferrer">{contest.name} ↗</a></h3>
              <p>{contest.platform} · {contest.duration}</p>
            </div>
            <time class="contest-time" datetime={start.toISOString()}>
              {start.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}<br />
              {start.toLocaleTimeString('zh-CN', {
                timeZone: 'Asia/Shanghai',
                hour: '2-digit',
                minute: '2-digit',
              })}
            </time>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .contest-board { min-height: 140px; }
  .contest-row { display: grid; grid-template-columns: 1fr auto; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .contest-row h3 { margin: 0 0 6px; }
  .contest-row h3 a { text-decoration: none; }
  .contest-row p { margin: 0; color: var(--muted); font-size: .9rem; }
  .contest-time { color: var(--accent); font: .8rem/1.7 'DM Mono', monospace; text-align: right; }

  @media (max-width: 560px) {
    .contest-row { grid-template-columns: 1fr; }
    .contest-time { text-align: left; }
  }
</style>
