---
import type { CodeforcesData } from '../utils/contest-data';
import { withBase } from '../utils/site';

interface Props {
  data: CodeforcesData;
}

const { data } = Astro.props;
const { profile, stats } = data;
const recent = data.recent_accepted.slice(0, 6);
const difficulty = data.difficulty;
const tags = data.top_tags;
const history = data.rating_history;
const highestBucket = Math.max(1, ...difficulty.map((item) => item.count));
const updatedDate = new Date(data.updated_at);
const updatedAt = Number.isNaN(updatedDate.getTime())
  ? '未知'
  : updatedDate.toLocaleString('zh-CN', {
      timeZone: 'Asia/Shanghai',
      dateStyle: 'medium',
      timeStyle: 'short',
    });
const isStale = Number.isNaN(updatedDate.getTime())
  || Date.now() - updatedDate.getTime() > 36 * 60 * 60 * 1000;
const knownRanks = [
  'newbie',
  'pupil',
  'specialist',
  'expert',
  'candidate master',
  'master',
  'international master',
  'grandmaster',
  'international grandmaster',
  'legendary grandmaster',
];
const rankClass = knownRanks.includes(profile.rank) ? profile.rank.replaceAll(' ', '-') : 'unrated';
const chartHistory = history.map(({ contest_name, rank, new_rating, delta, updated_at }) => ({
  contest_name,
  rank,
  new_rating,
  delta,
  updated_at,
}));
---

<section class="section" id="codeforces-record">
  <div class="shell">
    <div class="section-heading">
      <div><span class="eyebrow">01 / CODEFORCES LOG</span><h2>刷题成长记录</h2></div>
      <p>账号 <strong>InsaneArrogant</strong> 的公开训练数据。AC 题目按题目去重，数据每天自动同步一次。</p>
    </div>
    <div class="cf-sync-toolbar">
      <div class="cf-sync-status" role="status">
        <i class:list={{ 'is-stale': isStale }} aria-hidden="true"></i>
        <div>
          <strong>每日自动同步</strong>
          <span>最近同步：{updatedAt}{isStale ? ' · 等待下一次自动更新' : ' · 数据正常'}</span>
        </div>
      </div>
      <div class="cf-sync-actions">
        <a id="cf-refresh-page" href={withBase('/contests/')}>刷新页面</a>
        <a href="https://github.com/mxt1022/mxt1022.github.io/actions/workflows/update-codeforces.yml" target="_blank" rel="noreferrer">运行更新 ↗</a>
      </div>
    </div>

    <div class="cf-board">
      <div class="cf-overview">
        <article class="cf-profile-card">
          <span class="eyebrow">PUBLIC PROFILE</span>
          <a class="cf-handle" href={profile.profile_url} target="_blank" rel="noreferrer">
            {profile.handle} <span>↗</span>
          </a>
          <div class="cf-rank-line">
            <span class:list={['cf-rank', rankClass]}>{profile.rank}</span>
            <span>Rating {profile.rating || '—'} · Max {profile.max_rating || '—'}</span>
          </div>
          {profile.organization && <p class="cf-organization">{profile.organization}</p>}
          <dl class="cf-stats">
            <div><dt>{stats.solved_count}</dt><dd>已通过题目</dd></div>
            <div><dt>{stats.accepted_submissions}</dt><dd>AC 提交</dd></div>
            <div><dt>{stats.rated_contests}</dt><dd>Rated 场次</dd></div>
            <div><dt>{stats.active_days}</dt><dd>活跃天数</dd></div>
          </dl>
          <p class="cf-updated mono">Last sync · {updatedAt}</p>
        </article>

        <article class="cf-panel">
          <div class="cf-panel-heading">
            <span class="eyebrow">RECENT ACCEPTED</span>
            <a href={profile.profile_url} target="_blank" rel="noreferrer">查看主页 ↗</a>
          </div>
          <ol class="cf-solve-list">
            {recent.length === 0 && <li class="cf-empty">还没有可展示的 AC 记录。</li>}
            {recent.map((problem) => {
              const submittedAt = new Date(problem.submitted_at);
              const date = Number.isNaN(submittedAt.getTime())
                ? '—'
                : submittedAt.toLocaleDateString('zh-CN', {
                    timeZone: 'Asia/Shanghai',
                    month: '2-digit',
                    day: '2-digit',
                  });
              return (
                <li class="cf-solve-row">
                  <a href={problem.url || profile.profile_url} target="_blank" rel="noreferrer">
                    <span class="cf-problem-index">{problem.index || '?'}</span>
                    <span>
                      <strong>{problem.name || 'Untitled problem'}</strong>
                      <small>{date} · {problem.tags.slice(0, 2).join(' / ') || '未分类'}</small>
                    </span>
                    <span class="cf-problem-rating">{problem.rating || '—'}</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </article>
      </div>

      <div class="cf-analysis">
        {history.length > 0 && (
          <article class="cf-panel cf-rating-panel">
            <div class="cf-panel-heading">
              <div><span class="eyebrow">RATING HISTORY</span><h3>比赛 Rating 走势</h3></div>
              <span class="cf-chart-range mono">
                {new Date(history[0].updated_at).getFullYear()} — {new Date(history.at(-1)!.updated_at).getFullYear()}
              </span>
            </div>
            <div class="cf-chart-wrap">
              <canvas
                class="cf-rating-chart"
                role="img"
                aria-label={`${profile.handle} 共 ${history.length} 场 Rated 比赛的 Rating 折线图`}
                data-history={JSON.stringify(chartHistory)}
              ></canvas>
              <div class="cf-chart-tooltip" hidden></div>
            </div>
            <p class="cf-chart-detail mono" aria-live="polite"></p>
            <details class="cf-history-details">
              <summary>查看逐场 Rating 数据</summary>
              <div class="cf-history-table">
                <table>
                  <thead><tr><th>日期</th><th>比赛</th><th>排名</th><th>Rating</th><th>变化</th></tr></thead>
                  <tbody>
                    {[...history].reverse().map((point) => (
                      <tr>
                        <td>{new Date(point.updated_at).toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}</td>
                        <td><a href={point.url} target="_blank" rel="noreferrer">{point.contest_name}</a></td>
                        <td>{point.rank}</td>
                        <td>{point.new_rating}</td>
                        <td class={point.delta >= 0 ? 'positive' : 'negative'}>
                          {point.delta >= 0 ? '+' : ''}{point.delta}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </article>
        )}

        <article class="cf-panel">
          <span class="eyebrow">DIFFICULTY</span>
          <h3>已通过题目难度</h3>
          <div class="cf-bars">
            {difficulty.map((item) => (
              <div class="cf-bar-row">
                <span>{item.label || '—'}</span>
                <div class="cf-bar-track"><i style={`width:${Math.round((item.count / highestBucket) * 100)}%`}></i></div>
                <strong>{item.count}</strong>
              </div>
            ))}
          </div>
        </article>

        <article class="cf-panel">
          <span class="eyebrow">TOP TAGS</span>
          <h3>常练知识点</h3>
          <div class="cf-tags">
            {tags.map((tag) => <span class="cf-tag">{tag.name || 'other'} <b>{tag.count}</b></span>)}
          </div>
          <p class="cf-note">统计基于去重后的 AC 题目；无 Rating 的题目不会进入难度分布。</p>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  import type { RatingPoint } from '../utils/contest-data';

  type ChartPoint = Pick<RatingPoint, 'contest_name' | 'rank' | 'new_rating' | 'delta' | 'updated_at'>;
  let codeforcesChartCleanup: (() => void) | undefined;

  const setupCodeforcesRatingChart = (canvas: HTMLCanvasElement, points: ChartPoint[]) => {
    const context = canvas.getContext('2d');
    const wrap = canvas.closest<HTMLElement>('.cf-chart-wrap');
    const tooltip = wrap?.querySelector<HTMLElement>('.cf-chart-tooltip');
    const detail = wrap?.parentElement?.querySelector<HTMLElement>('.cf-chart-detail');
    if (!context || !wrap || points.length === 0) return;

    let plotted: { x: number; y: number }[] = [];
    let selected = points.length - 1;

    const pointLabel = (point: ChartPoint) => {
      const date = new Date(point.updated_at).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      });
      return `${date} · ${point.contest_name} · 排名 ${point.rank} · Rating ${point.new_rating}（${point.delta >= 0 ? '+' : ''}${point.delta}）`;
    };

    const draw = () => {
      const width = Math.max(220, Math.floor(wrap.clientWidth));
      const height = Math.max(260, Math.floor(canvas.getBoundingClientRect().height || 300));
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);

      const css = getComputedStyle(document.documentElement);
      const accent = css.getPropertyValue('--accent').trim();
      const background = css.getPropertyValue('--surface').trim();
      const muted = css.getPropertyValue('--muted').trim();
      const line = css.getPropertyValue('--line').trim();
      const text = css.getPropertyValue('--text').trim();
      const padding = { top: 24, right: 24, bottom: 38, left: 52 };
      const plotWidth = width - padding.left - padding.right;
      const plotHeight = height - padding.top - padding.bottom;
      const ratings = points.map((point) => point.new_rating);
      const rawMin = Math.min(...ratings);
      const rawMax = Math.max(...ratings);
      const yMin = Math.max(0, Math.floor((rawMin - 100) / 100) * 100);
      const yMax = Math.ceil((rawMax + 100) / 100) * 100;
      const yRange = Math.max(100, yMax - yMin);
      const toX = (index: number) => padding.left + (index / Math.max(1, points.length - 1)) * plotWidth;
      const toY = (rating: number) => padding.top + ((yMax - rating) / yRange) * plotHeight;

      context.font = '11px "DM Mono", monospace';
      context.textBaseline = 'middle';
      context.strokeStyle = line;
      context.fillStyle = muted;
      context.lineWidth = 1;
      for (let index = 0; index <= 4; index += 1) {
        const value = Math.round(yMax - (yRange * index) / 4);
        const y = padding.top + (plotHeight * index) / 4;
        context.beginPath();
        context.moveTo(padding.left, y);
        context.lineTo(width - padding.right, y);
        context.stroke();
        context.textAlign = 'right';
        context.fillText(String(value), padding.left - 10, y);
      }

      [...new Set([0, Math.floor((points.length - 1) / 2), points.length - 1])].forEach((index) => {
        const date = new Date(points[index].updated_at).toLocaleDateString('zh-CN', { year: '2-digit', month: '2-digit' });
        context.textAlign = index === 0 ? 'left' : index === points.length - 1 ? 'right' : 'center';
        context.fillText(date, toX(index), height - 14);
      });

      plotted = points.map((point, index) => ({ x: toX(index), y: toY(point.new_rating) }));
      const gradient = context.createLinearGradient(0, padding.top, 0, height - padding.bottom);
      gradient.addColorStop(0, accent.startsWith('#') ? `${accent}3d` : accent);
      gradient.addColorStop(1, 'transparent');
      context.beginPath();
      context.moveTo(plotted[0].x, height - padding.bottom);
      plotted.forEach((point) => context.lineTo(point.x, point.y));
      context.lineTo(plotted.at(-1)!.x, height - padding.bottom);
      context.closePath();
      context.fillStyle = gradient;
      context.fill();

      context.beginPath();
      plotted.forEach((point, index) => index === 0 ? context.moveTo(point.x, point.y) : context.lineTo(point.x, point.y));
      context.strokeStyle = accent;
      context.lineWidth = 2.5;
      context.lineJoin = 'round';
      context.lineCap = 'round';
      context.stroke();
      plotted.forEach((point, index) => {
        context.beginPath();
        context.arc(point.x, point.y, index === selected ? 5 : 3, 0, Math.PI * 2);
        context.fillStyle = index === selected ? accent : background;
        context.fill();
        context.strokeStyle = accent;
        context.lineWidth = 2;
        context.stroke();
      });

      const current = plotted[selected];
      context.fillStyle = text;
      context.font = '500 11px "DM Mono", monospace';
      context.textAlign = current.x > width - 90 ? 'right' : 'left';
      context.fillText(String(points[selected].new_rating), current.x + (current.x > width - 90 ? -9 : 9), current.y - 13);
      if (detail) detail.textContent = pointLabel(points[selected]);
    };

    const selectFromPointer = (event: PointerEvent) => {
      const x = event.clientX - canvas.getBoundingClientRect().left;
      selected = plotted.reduce(
        (closest, point, index) => Math.abs(point.x - x) < Math.abs(plotted[closest].x - x) ? index : closest,
        0,
      );
      draw();
      if (!tooltip) return;
      const strong = document.createElement('strong');
      const span = document.createElement('span');
      strong.textContent = points[selected].contest_name;
      span.textContent = `Rating ${points[selected].new_rating} · ${points[selected].delta >= 0 ? '+' : ''}${points[selected].delta} · 排名 ${points[selected].rank}`;
      tooltip.replaceChildren(strong, span);
      tooltip.hidden = false;
      const current = plotted[selected];
      tooltip.style.left = `${Math.min(Math.max(6, current.x - tooltip.offsetWidth / 2), wrap.clientWidth - tooltip.offsetWidth - 6)}px`;
      tooltip.style.top = `${Math.max(6, current.y - tooltip.offsetHeight - 14)}px`;
    };
    const resetPointer = () => {
      selected = points.length - 1;
      if (tooltip) tooltip.hidden = true;
      draw();
    };
    canvas.addEventListener('pointermove', selectFromPointer);
    canvas.addEventListener('pointerleave', resetPointer);
    const resizeObserver = new ResizeObserver(draw);
    const themeObserver = new MutationObserver(draw);
    resizeObserver.observe(wrap);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    draw();

    return () => {
      canvas.removeEventListener('pointermove', selectFromPointer);
      canvas.removeEventListener('pointerleave', resetPointer);
      resizeObserver.disconnect();
      themeObserver.disconnect();
    };
  };

  const setupCodeforcesDashboard = () => {
    codeforcesChartCleanup?.();
    codeforcesChartCleanup = undefined;
    const canvas = document.querySelector<HTMLCanvasElement>('.cf-rating-chart[data-history]');
    if (!canvas) return;
    try {
      const points = JSON.parse(canvas.dataset.history || '[]') as ChartPoint[];
      codeforcesChartCleanup = setupCodeforcesRatingChart(canvas, points);
    } catch {
      canvas.hidden = true;
    }
  };

  document.addEventListener('astro:page-load', setupCodeforcesDashboard);
  document.addEventListener('astro:before-swap', () => codeforcesChartCleanup?.());
</script>

<style is:global>
  .cf-sync-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 0 0 18px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: color-mix(in srgb, var(--accent) 5%, var(--surface)); }
  .cf-sync-status { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .cf-sync-status > i { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 13%, transparent); }
  .cf-sync-status > i.is-stale { background: var(--orange); box-shadow: 0 0 0 5px color-mix(in srgb, var(--orange) 13%, transparent); }
  .cf-sync-status strong, .cf-sync-status span { display: block; }
  .cf-sync-status strong { color: var(--text); font-size: .78rem; }
  .cf-sync-status span { margin-top: 2px; color: var(--muted); font: .66rem 'DM Mono', monospace; }
  .cf-sync-actions { display: flex; flex: 0 0 auto; gap: 8px; }
  .cf-sync-actions button, .cf-sync-actions a { display: inline-flex; align-items: center; justify-content: center; min-height: 34px; padding: 6px 11px; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); color: var(--muted); font: .66rem 'DM Mono', monospace; text-decoration: none; cursor: pointer; transition: border-color .2s, color .2s, background .2s; }
  .cf-sync-actions button:hover, .cf-sync-actions button:focus-visible, .cf-sync-actions a:hover, .cf-sync-actions a:focus-visible { border-color: var(--accent); color: var(--text); outline: none; }
  .cf-board { min-height: 280px; }
  .cf-overview { display: grid; grid-template-columns: minmax(280px, .78fr) minmax(0, 1.22fr); gap: 16px; }
  .cf-profile-card, .cf-panel { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  .cf-profile-card { padding: clamp(24px, 4vw, 36px); background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 10%, var(--surface)), var(--surface) 58%); }
  .cf-handle { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 18px 0 8px; text-decoration: none; font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 800; line-height: 1.05; letter-spacing: -.05em; }
  .cf-handle span { color: var(--accent); font-size: .7em; }
  .cf-rank-line { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--muted); font: .77rem 'DM Mono', monospace; }
  .cf-rank { padding: 4px 9px; border-radius: 999px; background: var(--surface-2); color: var(--muted); text-transform: capitalize; }
  .cf-rank.newbie { color: #a8aaa8; }
  .cf-rank.pupil { color: #2fb344; }
  .cf-rank.specialist { color: #16a3a3; }
  .cf-rank.expert { color: #3975dc; }
  .cf-rank.candidate-master { color: #a855f7; }
  .cf-rank.master, .cf-rank.international-master { color: #f59f00; }
  .cf-rank.grandmaster, .cf-rank.international-grandmaster, .cf-rank.legendary-grandmaster { color: #f03e3e; }
  .cf-organization { margin: 22px 0 0; color: var(--muted); }
  .cf-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin: 30px 0 0; padding: 1px; border-radius: 10px; background: var(--line); overflow: hidden; }
  .cf-stats div { padding: 18px; background: var(--surface); }
  .cf-stats dt { color: var(--text); font: 500 clamp(1.4rem, 3vw, 2rem) 'DM Mono', monospace; }
  .cf-stats dd { margin: 3px 0 0; color: var(--muted); font-size: .78rem; }
  .cf-updated { margin: 20px 0 0; color: var(--muted); font-size: .7rem; }
  .cf-panel { padding: clamp(22px, 3.5vw, 32px); }
  .cf-panel-heading { display: flex; justify-content: space-between; gap: 20px; align-items: center; margin-bottom: 12px; }
  .cf-panel-heading a { color: var(--muted); text-decoration: none; font-size: .8rem; }
  .cf-panel-heading a:hover { color: var(--accent); }
  .cf-solve-list { margin: 0; padding: 0; list-style: none; }
  .cf-solve-row { margin: 0; border-bottom: 1px solid var(--line); }
  .cf-solve-row:last-child { border-bottom: 0; }
  .cf-solve-row a { display: grid; grid-template-columns: 34px 1fr auto; gap: 14px; align-items: center; padding: 13px 0; text-decoration: none; }
  .cf-solve-row a:hover strong { color: var(--accent); }
  .cf-problem-index { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--line); border-radius: 6px; color: var(--accent); font: .72rem 'DM Mono', monospace; }
  .cf-solve-row strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .92rem; }
  .cf-solve-row small { display: block; margin-top: 2px; color: var(--muted); font-size: .7rem; }
  .cf-problem-rating { color: var(--muted); font: .72rem 'DM Mono', monospace; }
  .cf-empty { padding: 30px 0; color: var(--muted); }
  .cf-analysis { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .cf-panel h3 { margin: 10px 0 22px; font-size: 1.25rem; }
  .cf-bars { display: grid; gap: 11px; }
  .cf-bar-row { display: grid; grid-template-columns: 82px 1fr 28px; gap: 12px; align-items: center; color: var(--muted); font: .7rem 'DM Mono', monospace; }
  .cf-bar-track { height: 7px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
  .cf-bar-track i { display: block; height: 100%; min-width: 2px; border-radius: inherit; background: var(--accent); }
  .cf-bar-row strong { color: var(--text); text-align: right; }
  .cf-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .cf-tag { padding: 7px 10px; border: 1px solid var(--line); border-radius: 7px; color: var(--muted); font: .75rem 'DM Mono', monospace; }
  .cf-tag b { margin-left: 5px; color: var(--accent); font-weight: 500; }
  .cf-note { margin: 22px 0 0; color: var(--muted); font-size: .75rem; }
  .cf-rating-panel { grid-column: 1 / -1; }
  .cf-rating-panel .cf-panel-heading { align-items: end; margin-bottom: 6px; }
  .cf-rating-panel .cf-panel-heading h3 { margin-bottom: 0; }
  .cf-chart-range { color: var(--muted); font-size: .72rem; }
  .cf-chart-wrap { position: relative; width: 100%; }
  .cf-rating-chart { display: block; width: 100%; height: 310px; touch-action: pan-y; }
  .cf-chart-tooltip { position: absolute; z-index: 3; width: min(260px, calc(100% - 12px)); padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-2); box-shadow: var(--shadow); pointer-events: none; }
  .cf-chart-tooltip strong, .cf-chart-tooltip span { display: block; }
  .cf-chart-tooltip strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .78rem; }
  .cf-chart-tooltip span { margin-top: 3px; color: var(--muted); font: .68rem 'DM Mono', monospace; }
  .cf-chart-detail { min-height: 1.5em; margin: 5px 0 0; color: var(--muted); font-size: .68rem; }
  .cf-history-details { margin-top: 18px; padding-top: 15px; border-top: 1px solid var(--line); }
  .cf-history-details summary { width: max-content; color: var(--muted); cursor: pointer; font-size: .78rem; }
  .cf-history-details summary:hover { color: var(--accent); }
  .cf-history-table { margin-top: 14px; overflow-x: auto; }
  .cf-history-table table { width: 100%; border-collapse: collapse; font-size: .78rem; }
  .cf-history-table th, .cf-history-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .cf-history-table th { color: var(--muted); font: 500 .68rem 'DM Mono', monospace; text-transform: uppercase; }
  .cf-history-table td:nth-child(n+3) { white-space: nowrap; font-family: 'DM Mono', monospace; }
  .cf-history-table a { text-decoration: none; }
  .cf-history-table a:hover { color: var(--accent); }
  .cf-history-table .positive { color: var(--accent); }
  .cf-history-table .negative { color: var(--orange); }

  @media (max-width: 820px) {
    .cf-overview { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .cf-sync-toolbar { align-items: flex-start; flex-direction: column; }
    .cf-sync-actions { width: 100%; }
