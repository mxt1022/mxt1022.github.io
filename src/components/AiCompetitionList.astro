---
import type { CollectionEntry } from 'astro:content';
import CollapsibleContestSection from './CollapsibleContestSection.astro';
import CompetitionProgress from './CompetitionProgress.astro';
import { formatDate, withBase } from '../utils/site';
import { getActiveContentStatus } from '../utils/content-status';

interface Props {
  experiences: CollectionEntry<'experiences'>[];
}

const { experiences } = Astro.props;
const trackedExperiences = experiences.filter((entry) => entry.data.progress);
const submissionCount = trackedExperiences.reduce(
  (total, entry) => total + (entry.data.progress?.submissions.length ?? 0),
  0,
);
const platformCount = new Set(experiences.map((entry) => entry.data.platform)).size;
---

<CollapsibleContestSection
  id="ai-competitions"
  eyebrow="02 / AI COMPETITIONS"
  title="AI 竞赛经历"
  description="每场比赛集中展示任务介绍、实践状态和提交时间轴；按时间保留改进策略、分数变化与实验结论。"
  count={experiences.length}
  countLabel="场竞赛"
>
    <dl class="ai-overview" aria-label="AI 竞赛统计">
      <div><dt>{experiences.length}</dt><dd>AI 竞赛与实践</dd></div>
      <div><dt>{trackedExperiences.length}</dt><dd>包含提交时间轴</dd></div>
      <div><dt>{submissionCount}</dt><dd>记录的提交与实验</dd></div>
      <div><dt>{platformCount}</dt><dd>竞赛平台</dd></div>
    </dl>
    <div class="ai-filter-bar" aria-label="筛选 AI 竞赛经历">
      <button class="active" type="button" data-ai-filter="all">全部</button>
      <button type="button" data-ai-filter="tracked">有提交记录</button>
      <button type="button" data-ai-filter="practice">实践记录</button>
      <button type="button" data-ai-filter="demo">示例数据</button>
      <span id="ai-filter-count">{experiences.length} 条记录</span>
    </div>
    <div class="ai-experience-list">
      {experiences.map((entry) => {
        const progress = entry.data.progress;
        const submissions = progress
          ? [...progress.submissions].sort((a, b) => a.time.valueOf() - b.time.valueOf())
          : [];
        const scores = submissions.map((submission) => submission.score);
        const bestScore = progress && scores.length
          ? (progress.goal === 'lower' ? Math.min(...scores) : Math.max(...scores))
          : null;
        const latestScore = submissions.at(-1)?.score ?? null;
        const activeStatus = getActiveContentStatus(entry.data.status);
        const formatScore = (score: number | null) =>
          score === null || !progress ? '—' : `${score.toFixed(progress.precision)}${progress.scoreSuffix}`;

        return (
          <details
            class="ai-experience"
            data-ai-kind={progress ? 'tracked' : 'practice'}
            data-ai-demo={progress?.demo ? 'true' : 'false'}
          >
            <summary class="ai-experience-intro">
              <div class="timeline-meta">
                <div>{formatDate(entry.data.date)}</div>
                <div>{entry.data.platform}</div>
                {activeStatus && <span class="content-status">{activeStatus}</span>}
              </div>
              <div class="ai-experience-copy">
                <span class="eyebrow">{progress ? 'SUBMISSION TRACKED' : 'PRACTICE LOG'}</span>
                <h3><a href={withBase(`/contests/${entry.id}/`)}>{entry.data.title}</a></h3>
                <p>{entry.data.description}</p>
                <div class="tag-list">{entry.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}</div>
              </div>
              <dl class="ai-summary-metrics" aria-label={`${entry.data.title} 摘要`}>
                <div><dt>{submissions.length || '—'}</dt><dd>提交</dd></div>
                <div><dt>{formatScore(bestScore)}</dt><dd>最佳</dd></div>
                <div><dt>{formatScore(latestScore)}</dt><dd>最新</dd></div>
              </dl>
              <span class="ai-expand-label">
                <span class="when-closed">展开记录</span>
                <span class="when-open">收起记录</span> ↓
              </span>
            </summary>
            {progress && (
              <div class="ai-experience-progress">
                <CompetitionProgress
                  title={entry.data.title}
                  platform={entry.data.platform}
                  progress={progress}
                  href={withBase(`/contests/${entry.id}/`)}
                  compact
                />
              </div>
            )}
            {!progress && (
              <div class="ai-practice-note">
                <p>这项实践暂未配置提交分数时间轴，完整过程与方法记录保存在复盘文章中。</p>
                <a class="text-link" href={withBase(`/contests/${entry.id}/`)}>阅读完整复盘 ↗</a>
              </div>
            )}
          </details>
        );
      })}
      <p id="ai-filter-empty" class="empty-state" hidden>当前筛选下没有对应的 AI 竞赛记录。</p>
    </div>
</CollapsibleContestSection>

<script>
  const setupAiCompetitionFilters = () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-ai-filter]')];
    const entries = [...document.querySelectorAll<HTMLDetailsElement>('.ai-experience[data-ai-kind]')];
    const count = document.querySelector<HTMLElement>('#ai-filter-count');
    const empty = document.querySelector<HTMLElement>('#ai-filter-empty');

    buttons.forEach((button) => {
      button.onclick = () => {
        const filter = button.dataset.aiFilter || 'all';
        let visible = 0;
        buttons.forEach((item) => item.classList.toggle('active', item === button));
        entries.forEach((entry) => {
          const show = filter === 'all'
            || (filter === 'demo' ? entry.dataset.aiDemo === 'true' : entry.dataset.aiKind === filter);
          entry.hidden = !show;
          if (show) visible += 1;
        });
        if (count) count.textContent = `${visible} 条记录`;
        if (empty) empty.hidden = visible > 0;
      };
    });
  };

  document.addEventListener('astro:page-load', setupAiCompetitionFilters);
</script>

<style>
  .ai-experience-list { display: grid; gap: clamp(18px, 3vw, 28px); }
  .ai-overview { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 0 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); overflow: hidden; }
  .ai-overview div { padding: 20px; border-right: 1px solid var(--line); }
  .ai-overview div:last-child { border-right: 0; }
  .ai-overview dt { color: var(--text); font: 500 clamp(1.4rem, 3vw, 2rem) 'DM Mono', monospace; }
  .ai-overview dd { margin: 4px 0 0; color: var(--muted); font-size: .72rem; }
  .ai-filter-bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 24px; }
  .ai-filter-bar button { padding: 7px 12px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--muted); font: .68rem 'DM Mono', monospace; cursor: pointer; }
  .ai-filter-bar button:hover, .ai-filter-bar button:focus-visible, .ai-filter-bar button.active { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--surface)); color: var(--text); outline: none; }
  .ai-filter-bar > span { margin-left: auto; color: var(--muted); font: .68rem 'DM Mono', monospace; }
  .ai-experience { display: block; width: 100%; min-width: 0; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); overflow: hidden; }
  .ai-experience[hidden] { display: none; }
  .ai-experience-intro { position: relative; display: grid; grid-template-columns: 150px minmax(0, 1fr) minmax(250px, .52fr); gap: clamp(24px, 4vw, 54px); align-items: start; padding: clamp(26px, 4vw, 42px); cursor: pointer; list-style: none; }
  .ai-experience-intro::-webkit-details-marker { display: none; }
  .ai-experience-copy { min-width: 0; }
  .ai-experience-intro h3 { margin: 12px 0 14px; font-size: clamp(1.45rem, 3vw, 2rem); }
  .ai-experience-intro h3 a { text-decoration: none; }
  .ai-experience-intro h3 a:hover { color: var(--accent); }
  .ai-experience-intro p { margin: 0; color: var(--muted); }
  .ai-summary-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-self: center; margin: 0; }
  .ai-summary-metrics div { min-width: 0; padding: 8px 12px; border-left: 1px solid var(--line); }
  .ai-summary-metrics dt { overflow: hidden; color: var(--text); font: 500 .85rem 'DM Mono', monospace; text-overflow: ellipsis; white-space: nowrap; }
  .ai-summary-metrics dd { margin: 4px 0 0; color: var(--muted); font-size: .62rem; }
  .ai-expand-label { position: absolute; right: 20px; bottom: 12px; color: var(--muted); font: .62rem 'DM Mono', monospace; }
  .ai-expand-label .when-open { display: none; }
  .ai-experience[open] .ai-expand-label .when-closed { display: none; }
  .ai-experience[open] .ai-expand-label .when-open { display: inline; }
  .ai-experience[open] .ai-expand-label { color: var(--accent); }
  .ai-experience-progress, .ai-practice-note { width: 100%; margin: 16px 0 0; }
  .ai-practice-note { display: flex; justify-content: space-between; gap: 24px; align-items: center; padding: 20px 24px; border-left: 2px solid var(--accent); background: var(--surface); }
  .ai-practice-note p { margin: 0; color: var(--muted); font-size: .84rem; }

  @media (max-width: 820px) {
    .ai-experience-intro { grid-template-columns: 130px minmax(0, 1fr); }
    .ai-summary-metrics { grid-column: 1 / -1; }
    .ai-summary-metrics div:first-child { border-left: 0; }
  }

  @media (max-width: 560px) {
    .ai-experience-intro { grid-template-columns: 1fr; gap: 14px; }
    .ai-overview { grid-template-columns: repeat(2, 1fr); }
    .ai-overview div:nth-child(2) { border-right: 0; }
    .ai-overview div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .ai-filter-bar > span { width: 100%; margin-left: 0; }
    .ai-summary-metrics { margin: 6px 0 18px; }
    .ai-practice-note { align-items: flex-start; flex-direction: column; }
  }
</style>
