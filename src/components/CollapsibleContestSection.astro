---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
  count: number;
  countLabel: string;
  open?: boolean;
}

const {
  id,
  eyebrow,
  title,
  description,
  count,
  countLabel,
  open = false,
} = Astro.props;
---

<section class="section contest-section" id={id}>
  <div class="shell">
    <details class="contest-section-fold" open={open}>
      <summary class="contest-section-summary">
        <div class="contest-section-title">
          <span class="eyebrow">{eyebrow}</span>
          <h2>{title}</h2>
        </div>
        <p>{description}</p>
        <div class="contest-section-control" aria-hidden="true">
          <span class="contest-section-count"><strong>{count}</strong> {countLabel}</span>
          <span class="contest-section-state">
            <span class="when-closed">展开全部记录</span>
            <span class="when-open">收起整个板块</span>
          </span>
          <i>↓</i>
        </div>
      </summary>
      <div class="contest-section-content">
        <slot />
      </div>
    </details>
  </div>
</section>

<style>
  .contest-section { padding: clamp(38px, 6vw, 64px) 0; }
  .contest-section-fold { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); transition: border-color .2s, box-shadow .2s; }
  .contest-section-fold:hover { border-color: color-mix(in srgb, var(--accent) 46%, var(--line)); }
  .contest-section-fold[open] { border-color: color-mix(in srgb, var(--accent) 34%, var(--line)); box-shadow: var(--shadow); }
  .contest-section-summary { display: grid; grid-template-columns: minmax(240px, .82fr) minmax(300px, 1fr) auto; gap: clamp(24px, 4vw, 52px); align-items: end; padding: clamp(26px, 4vw, 40px); cursor: pointer; list-style: none; }
  .contest-section-summary::-webkit-details-marker { display: none; }
  .contest-section-summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .contest-section-title h2 { margin: 8px 0 0; font-size: clamp(1.8rem, 4vw, 3.25rem); line-height: 1.04; letter-spacing: -.05em; }
  .contest-section-summary > p { max-width: 520px; margin: 0; color: var(--muted); font-size: .9rem; }
  .contest-section-control { display: grid; grid-template-columns: auto 38px; gap: 6px 14px; align-items: center; justify-items: end; min-width: 146px; color: var(--muted); font: .66rem 'DM Mono', monospace; white-space: nowrap; }
  .contest-section-count { grid-column: 1; color: var(--text); }
  .contest-section-count strong { margin-right: 3px; color: var(--accent); font-size: 1.1rem; }
  .contest-section-state { grid-column: 1; }
  .contest-section-control i { grid-column: 2; grid-row: 1 / 3; display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 50%; color: var(--accent); font-style: normal; font-size: .9rem; transition: transform .25s ease, background .2s; }
  .contest-section-summary:hover .contest-section-control i { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .contest-section-control .when-open { display: none; }
  .contest-section-fold[open] .contest-section-summary { border-bottom: 1px solid var(--line); }
  .contest-section-fold[open] .contest-section-control .when-closed { display: none; }
  .contest-section-fold[open] .contest-section-control .when-open { display: inline; }
  .contest-section-fold[open] .contest-section-control i { transform: rotate(180deg); }
  .contest-section-content { padding: clamp(24px, 4vw, 40px); }

  @media (max-width: 820px) {
    .contest-section-summary { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    .contest-section-summary > p { grid-column: 1 / -1; grid-row: 2; }
    .contest-section-control { grid-column: 2; grid-row: 1; }
  }

  @media (max-width: 560px) {
    .contest-section { padding: 30px 0; }
    .contest-section-summary { grid-template-columns: 1fr; gap: 18px; padding: 24px 20px; }
    .contest-section-summary > p { grid-column: 1; grid-row: auto; }
    .contest-section-control { grid-column: 1; grid-row: auto; grid-template-columns: auto 34px; justify-items: start; min-width: 0; }
    .contest-section-control i { width: 34px; height: 34px; }
    .contest-section-content { padding: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contest-section-fold, .contest-section-control i { transition: none; }
  }
</style>
