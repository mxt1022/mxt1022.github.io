---
import '../styles/fonts.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import manropeFont from '../assets/fonts/manrope-latin.woff2?url';
import signatureFont from '../assets/fonts/homemade-apple-400.woff2?url';
import { siteImages } from '../utils/images';
import { siteMeta, withBase } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  image = siteImages.og,
  structuredData = [],
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
const usesDefaultOgImage = image === siteImages.og;
const pageTitle = title === siteMeta.title ? title : `${title} · ${siteMeta.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(withBase('/'), Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(base, '') || '/';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteMeta.title,
  url: siteUrl.href,
  description: siteMeta.description,
  author: {
    '@type': 'Person',
    name: siteMeta.author,
    url: new URL(withBase('/profile/'), Astro.site).href,
  },
};
const pageSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemas = [websiteSchema, ...pageSchemas];
const serializeSchema = (schema: Record<string, unknown>) =>
  JSON.stringify(schema).replace(/</g, '\\u003c');
const nav = [
  { href: '/', label: '首页' },
  { href: '/profile/', label: '个人主页' },
  { href: '/notes/', label: '学习记录' },
  { href: '/projects/', label: '项目案例' },
  { href: '/contests/', label: '竞赛经历' },
  { href: '/about/', label: '关于本站' },
];
const pageTransition = {
  forwards: {
    old: { name: 'page-out-forward', duration: '180ms', easing: 'cubic-bezier(.4, 0, 1, 1)', fillMode: 'both' },
    new: { name: 'page-in-forward', duration: '360ms', easing: 'cubic-bezier(.16, 1, .3, 1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'page-out-back', duration: '180ms', easing: 'cubic-bezier(.4, 0, 1, 1)', fillMode: 'both' },
    new: { name: 'page-in-back', duration: '360ms', easing: 'cubic-bezier(.16, 1, .3, 1)', fillMode: 'both' },
  },
};
---

<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d0e" />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={signatureFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href={siteImages.logo.favicon} />
    <link rel="alternate" type="application/rss+xml" title={siteMeta.title} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteMeta.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:alt" content="mxt.log：把学习过程编译成记录" />
    {usesDefaultOgImage && <meta property="og:image:type" content="image/jpeg" />}
    {usesDefaultOgImage && <meta property="og:image:width" content="1200" />}
    {usesDefaultOgImage && <meta property="og:image:height" content="630" />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={siteMeta.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:image:alt" content="mxt.log：把学习过程编译成记录" />
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={serializeSchema(schema)}></script>
    ))}
    <title>{pageTitle}</title>
    <ClientRouter fallback="animate" />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          theme = localStorage.getItem('theme') || 'dark';
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#f3f2ec' : '#0b0d0e');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="brand" href={withBase('/')} aria-label="mxt.log 首页">
          <span class="brand-mark" aria-hidden="true"><img src={siteImages.logo.nav} alt="" width="30" height="30" decoding="async" /></span>
          <span>mxt<span class="accent">.log</span></span>
        </a>
        <nav aria-label="主导航">
          {nav.map((item) => (
            <a
              class:list={{ active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }}
              href={withBase(item.href)}
              aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <button class="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题"><span aria-hidden="true">◐</span></button>
      </div>
    </header>

    <main id="content" transition:name="page-content" transition:animate={pageTransition}><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand" href={withBase('/')}><span class="brand-mark" aria-hidden="true"><img src={siteImages.logo.nav} alt="" width="30" height="30" loading="lazy" decoding="async" /></span><span>mxt<span class="accent">.log</span></span></a>
          <p>持续学习，持续复盘，持续输出。</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/mxt1022" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="mailto:mxt1022@outlook.com">Email ↗</a>
          <a href={withBase('/rss.xml')}>RSS ↗</a>
        </div>
        <p class="copyright">© {new Date().getFullYear()} mxt · Built with Astro</p>
      </div>
    </footer>

    <script>
      const copyCode = async (text: string) => {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
        await navigator.clipboard.writeText(text);
      };

      const setupCodeCopyButtons = () => {
        document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
          if (pre.closest('.code-block')) return;
          const code = pre.querySelector('code');
          if (!code) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block';
          pre.before(wrapper);
          wrapper.append(pre);

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'code-copy';
          button.textContent = '复制';
          button.setAttribute('aria-label', '复制代码');
          wrapper.append(button);

          button.addEventListener('click', async () => {
            try {
              await copyCode(code.textContent || '');
              button.textContent = '已复制';
              button.classList.add('is-copied');
              button.setAttribute('aria-label', '代码已复制');
            } catch {
              button.textContent = '复制失败';
              button.classList.add('is-error');
              button.setAttribute('aria-label', '代码复制失败');
            }

            window.setTimeout(() => {
              button.textContent = '复制';
              button.classList.remove('is-copied', 'is-error');
              button.setAttribute('aria-label', '复制代码');
            }, 1600);
          });
        });
      };

      const setupThemeToggle = () => {
        const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
        button?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f3f2ec' : '#0b0d0e');
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });
      };

      document.addEventListener('astro:before-swap', (event) => {
        let storedTheme = 'dark';
        try {
          storedTheme = localStorage.getItem('theme') || 'dark';
        } catch {}
        const theme = document.documentElement.dataset.theme || storedTheme;
        event.newDocument.documentElement.dataset.theme = theme;
        event.newDocument.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#f3f2ec' : '#0b0d0e');
      });
      document.addEventListener('astro:page-load', setupThemeToggle);
      document.addEventListener('astro:page-load', setupCodeCopyButtons);
    </script>
  </body>
</html>
