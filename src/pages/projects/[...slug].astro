---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, withBase } from '../../utils/site';
import { absoluteSiteUrl, createBreadcrumbSchema } from '../../utils/structured-data';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
const resolveHref = (href: string) => href.startsWith('http') || href.startsWith('mailto:') ? href : withBase(href);
const projectPath = `/projects/${project.id}/`;
const repository = project.data.links.find((link) => link.href.includes('github.com'))?.href;
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.data.title,
  description: project.data.description,
  dateCreated: project.data.date.toISOString(),
  dateModified: (project.data.updated ?? project.data.date).toISOString(),
  url: absoluteSiteUrl(projectPath, Astro.site),
  codeRepository: repository,
  programmingLanguage: project.data.stack,
  author: {
    '@type': 'Person',
    name: 'mxt',
    url: absoluteSiteUrl('/profile/', Astro.site),
  },
};
const projectBreadcrumbs = createBreadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '项目案例', path: '/projects/' },
  { name: project.data.title, path: projectPath },
], Astro.site);
---

<Layout
  title={project.data.title}
  description={project.data.description}
  structuredData={[projectSchema, projectBreadcrumbs]}
>
  <header class="article-header project-header">
    <div class="shell">
      <a class="back-link" href={withBase('/projects/')}>← 返回项目案例</a>
      <span class="eyebrow">{project.data.status} / {project.data.role}</span>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      <div class="article-meta">
        <time datetime={project.data.date.toISOString()}>开始于 {formatDate(project.data.date)}</time>
        {project.data.updated && <span>更新于 {formatDate(project.data.updated)}</span>}
      </div>
      <div class="project-links">
        {project.data.links.map((link, index) => (
          <a
            class:list={['button', { primary: index === 0 }]}
            href={resolveHref(link.href)}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
          >
            {link.label}{link.href.startsWith('http') ? ' ↗' : ' →'}
          </a>
        ))}
      </div>
    </div>
  </header>

  <div class="project-detail shell">
    <aside class="project-facts">
      <span class="eyebrow">PROJECT PROFILE</span>
      <dl>
        <div><dt>状态</dt><dd>{project.data.status}</dd></div>
        <div><dt>角色</dt><dd>{project.data.role}</dd></div>
        <div><dt>技术栈</dt><dd>{project.data.stack.join(' · ')}</dd></div>
      </dl>
      {project.data.highlights.length > 0 && (
        <div class="project-highlights">
          <strong>关键内容</strong>
          <ul>{project.data.highlights.map((item) => <li>{item}</li>)}</ul>
        </div>
      )}
    </aside>
    <article class="prose"><Content /></article>
  </div>

  <style>
    .project-header :global(.shell) { max-width: 1120px; }
    .project-header h1 { max-width: 920px; }
    .project-links { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 28px; }
    .project-detail { display: grid; grid-template-columns: 270px minmax(0, 760px); justify-content: center; gap: clamp(48px, 8vw, 100px); align-items: start; }
    .project-facts { position: sticky; top: 108px; margin: 56px 0; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
    .project-facts dl { margin: 20px 0 0; }
    .project-facts dl div { padding: 13px 0; border-bottom: 1px solid var(--line); }
    .project-facts dt { color: var(--muted); font: .62rem 'DM Mono', monospace; text-transform: uppercase; }
    .project-facts dd { margin: 5px 0 0; font-size: .82rem; }
    .project-highlights { margin-top: 24px; }
    .project-highlights strong { font-size: .78rem; }
    .project-highlights ul { display: grid; gap: 9px; margin: 12px 0 0; padding-left: 18px; color: var(--muted); font-size: .76rem; }

    @media (max-width: 820px) {
      .project-detail { grid-template-columns: 1fr; gap: 0; }
      .project-facts { position: static; margin: 40px 0 0; }
    }
  </style>
</Layout>
