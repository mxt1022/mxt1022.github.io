---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CompetitionProgress from '../../components/CompetitionProgress.astro';
import Layout from '../../layouts/Layout.astro';
import { siteImages } from '../../utils/images';
import { formatDate, withBase } from '../../utils/site';
import { absoluteSiteUrl, createBreadcrumbSchema } from '../../utils/structured-data';
import { getActiveContentStatus } from '../../utils/content-status';

export async function getStaticPaths() {
  const entries = await getCollection('experiences', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'experiences'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const activeStatus = getActiveContentStatus(entry.data.status);
const relatedNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .filter((note) => note.data.relatedExperience === entry.id);
const entryPath = `/contests/${entry.id}/`;
const contestSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  mainEntityOfPage: absoluteSiteUrl(entryPath, Astro.site),
  image: new URL(siteImages.og, Astro.site).href,
  keywords: entry.data.tags,
  about: [entry.data.type, entry.data.platform],
  author: {
    '@type': 'Person',
    name: 'mxt',
    url: absoluteSiteUrl('/profile/', Astro.site),
  },
};
const contestBreadcrumbs = createBreadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '竞赛经历', path: '/contests/' },
  { name: entry.data.title, path: entryPath },
], Astro.site);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  structuredData={[contestSchema, contestBreadcrumbs]}
  ogType="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
>
  <header class="article-header">
    <div class="narrow">
      <a class="back-link" href={withBase('/contests/')}>← 返回竞赛经历</a>
      <span class="eyebrow">{entry.data.type} / {entry.data.platform}</span>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="article-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>{activeStatus && <span class="content-status">{activeStatus}</span>}<span>{entry.data.tags.map((tag: string) => `#${tag}`).join(' · ')}</span></div>
    </div>
  </header>
  {relatedNotes.length > 0 && (
    <aside class="related-learning narrow" aria-label="相关学习记录">
      <div>
        <span class="eyebrow">KNOWLEDGE NOTES</span>
        <strong>比赛结果与方法沉淀已分开整理</strong>
        <p>本页保留提交、分数和复盘；可复用的数据、特征与建模方法请前往学习记录。</p>
      </div>
      <div class="related-learning-links">
        {relatedNotes.map((note) => (
          <a href={withBase(`/notes/${note.id}/`)}>{note.data.title} →</a>
        ))}
      </div>
    </aside>
  )}
  {entry.data.progress && (
    <section class="contest-progress-section shell">
      <CompetitionProgress
        title={entry.data.title}
        platform={entry.data.platform}
        progress={entry.data.progress}
      />
    </section>
  )}
  <article class="prose narrow"><Content /></article>

  <style>
    .related-learning { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: center; margin-top: 34px; padding: 20px 22px; border-left: 2px solid var(--accent); background: var(--surface); }
    .related-learning strong { display: block; margin-top: 6px; }
    .related-learning p { margin: 7px 0 0; color: var(--muted); font-size: .82rem; }
    .related-learning-links { display: grid; gap: 8px; justify-items: end; }
    .related-learning-links a { color: var(--accent); font-size: .76rem; text-align: right; text-decoration: none; }
    @media (max-width: 680px) {
      .related-learning { grid-template-columns: 1fr; }
      .related-learning-links { justify-items: start; }
      .related-learning-links a { text-align: left; }
    }
  </style>
</Layout>
