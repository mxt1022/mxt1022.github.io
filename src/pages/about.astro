---
import Layout from '../layouts/Layout.astro';
import { siteImages } from '../utils/images';
import { withBase } from '../utils/site';

const techStack = [
  { name: 'C++', category: '语言', slug: 'cplusplus', color: '00599C' },
  { name: 'Python', category: '语言', slug: 'python', color: '3776AB' },
  { name: 'Java', category: '语言', slug: 'openjdk', color: 'ED8B00' },
  { name: 'TypeScript', category: '语言', slug: 'typescript', color: '3178C6' },
  { name: 'PyTorch', category: 'AI / ML', slug: 'pytorch', color: 'EE4C2C' },
  { name: 'TensorFlow', category: 'AI / ML', slug: 'tensorflow', color: 'FF6F00' },
  { name: 'scikit-learn', category: 'AI / ML', slug: 'scikitlearn', color: 'F7931E' },
  { name: 'Astro', category: 'Web', slug: 'astro', color: 'BC52EE' },
  { name: 'Git', category: '工具', slug: 'git', color: 'F05032' },
  { name: 'Linux', category: '工具', slug: 'linux', color: 'FCC624' },
];

const contentMap = [
  { title: '学习记录', description: '整理课程、论文与技术主题，保留推导、代码和仍待解决的问题。', href: '/notes/' },
  { title: '竞赛经历', description: '记录算法训练与 AI 竞赛的提交、分数、策略变化和赛后复盘。', href: '/contests/' },
  { title: '项目案例', description: '把项目目标、技术选择、实现过程与迭代结果沉淀为可复用经验。', href: '/projects/' },
  { title: '个人主页', description: '集中展示 mxt1022 的个人简介、学术方向、项目与竞赛实践。', href: '/profile/' },
];
---

<Layout title="关于本站" description="关于 mxt.log：一份持续更新的学习、竞赛与项目记录。">
  <header class="page-hero shell">
    <span class="eyebrow">ABOUT THE SITE / HOW IT WORKS</span>
    <h1>关于这份<br />长期学习记录</h1>
  </header>

  <section class="section">
    <div class="shell profile-grid">
      <aside class="profile-card">
        <img
          class="profile-avatar profile-logo"
          src={siteImages.logo.about}
          srcset={siteImages.logo.aboutSrcSet}
          sizes="140px"
          alt="mxt.log 标志"
          width="140"
          height="140"
          decoding="async"
        />
        <span class="eyebrow">ABOUT THE SITE</span>
        <h2>mxt.log</h2>
        <p>一个用于整理学习记录、竞赛实验和项目复盘的长期技术博客。</p>
        <div class="footer-links">
          <a href={withBase('/profile/')}>个人主页 →</a>
          <a href={withBase('/rss.xml')}>RSS →</a>
        </div>
      </aside>

      <div class="about-copy">
        <section>
          <span class="eyebrow">WHY THIS BLOG</span>
          <h2>记录不是终点，而是一次重新理解。</h2>
          <p>mxt.log 从早期的课程 Wiki 演进而来。它不包装“标准答案”，而是保留问题如何被拆解、实验怎样改进，以及哪些判断曾经出错。内容持续更新，也允许旧结论被新实践修正。</p>
        </section>

        <section>
          <span class="eyebrow">CONTENT STRUCTURE</span>
          <h2>内容如何组织</h2>
          <div class="roadmap">
            {contentMap.map((item) => (
              <div>
                <strong><a href={withBase(item.href)}>{item.title} →</a></strong><br />
                <span>{item.description}</span>
              </div>
            ))}
          </div>
        </section>

        <section>
          <span class="eyebrow">TOOLBOX</span>
          <h2>建站与内容工具</h2>
          <p>这些语言、框架与工具出现在博客的构建、算法代码、AI 实验和项目实践中；技术栈会随着内容一起持续演进。</p>
          <div class="tech-stack" aria-label="本站技术栈列表">
            {techStack.map((tech) => (
              <article class="tech-item" style={`--tech-color: #${tech.color}`}>
                <div class="tech-icon">
                  <img
                    src={withBase(`/assets/icons/${tech.slug}.svg`)}
                    alt=""
                    width="28"
                    height="28"
                    loading="lazy"
                  />
                </div>
                <div>
                  <strong>{tech.name}</strong>
                  <span>{tech.category}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section>
          <span class="eyebrow">MAINTENANCE</span>
          <h2>持续维护，而不是一次完成</h2>
          <p>每篇内容都可以继续迭代：补充代码、修正结论、链接后续实践。博客的价值不在于看起来“已经学完”，而在于让学习、实验和项目形成一条可以回看、验证与延伸的轨迹。</p>
        </section>
      </div>
    </div>
  </section>
</Layout>
