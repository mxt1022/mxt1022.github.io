---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { withBase } from '../utils/site';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const experiences = (await getCollection('experiences', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const standaloneNotes = notes.filter((note) => !note.data.relatedExperience);
const recentNotes = standaloneNotes.slice(0, 2);
const recentExperiences = experiences.slice(0, 2);
const noteCount = notes.length;
const tagCount = new Set(notes.flatMap((note) => note.data.tags)).size;
---

<Layout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="hero-kicker"><span class="status-dot"></span> Learning in public · 2026</p>
        <h1>把学习过程<br /><span>编译成记录。</span></h1>
        <p class="hero-intro">这里记录计算机科学、算法与人工智能的学习轨迹，也保存每次比赛从数据、思路到复盘的完整过程。</p>
        <div class="hero-actions">
          <a class="button primary" href={withBase('/notes/')}>浏览学习记录 <span aria-hidden="true">→</span></a>
          <a class="button" href={withBase('/contests/')}>查看竞赛经历</a>
        </div>
        <div class="hero-signature" role="img" aria-label="mxt1022 签名">
          <div class="signature-mark" aria-hidden="true">
            <span class="signature-reveal"><span class="signature-word">mxt1022</span></span>
          </div>
          <span class="signature-caption" aria-hidden="true">SIGNED / KEEP ITERATING</span>
        </div>
      </div>
      <aside class="hero-panel" aria-label="博客概览">
        <div class="panel-top"><i></i><i></i><i></i></div>
        <div class="terminal">
          <div><span class="prompt">$</span> whoami</div>
          <div><strong>mxt / CS learner</strong></div><br />
          <div><span class="prompt">$</span> ls ./focus</div>
          <div><strong>algorithms&nbsp; ai&nbsp; systems</strong></div><br />
          <div><span class="prompt">$</span> blog --stats</div>
          <div><strong>{String(noteCount).padStart(2, '0')}</strong> notes · <strong>{String(experiences.length).padStart(2, '0')}</strong> reviews · <strong>{String(tagCount).padStart(2, '0')}</strong> tags</div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">01 / RECENT OUTPUT</span><h2>最近写下的内容</h2></div>
        <p>学习记录沉淀知识与方法，竞赛复盘保留提交、分数和策略；关联内容不在聚合区重复展示。</p>
      </div>
      <div class="recent-output-groups">
        <section class="recent-output-group" aria-labelledby="recent-notes-title">
          <div class="recent-output-heading">
            <span class="eyebrow">KNOWLEDGE NOTES</span>
            <h3 id="recent-notes-title">学习记录</h3>
            <a href={withBase('/notes/')}>查看全部 →</a>
          </div>
          <div class="post-grid">
            {recentNotes.map((note, index) => (
              <PostCard
                title={note.data.title}
                description={note.data.description}
                date={note.data.updated ?? note.data.date}
                tags={note.data.tags}
                label={`${note.data.category} · 学习笔记`}
                href={`/notes/${note.id}/`}
                featured={index === 0}
              />
            ))}
          </div>
        </section>
        <section class="recent-output-group" aria-labelledby="recent-contests-title">
          <div class="recent-output-heading">
            <span class="eyebrow">COMPETITION REVIEWS</span>
            <h3 id="recent-contests-title">竞赛复盘</h3>
            <a href={withBase('/contests/')}>查看全部 →</a>
          </div>
          <div class="post-grid">
            {recentExperiences.map((entry, index) => (
              <PostCard
                title={entry.data.title}
                description={entry.data.description}
                date={entry.data.updated ?? entry.data.date}
                tags={entry.data.tags}
                label={`${entry.data.type} · 结果记录`}
                href={`/contests/${entry.id}/`}
                featured={index === 0}
              />
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">02 / LEARNING TRACKS</span><h2>正在推进的方向</h2></div>
        <p>按长期主题组织，而不是让知识散落在时间线里。</p>
      </div>
      <div class="tracks">
        <article class="track"><span class="track-index">[ 01 ]</span><h3>算法与数据结构</h3><p>题型、模板、复杂度与解题复盘。</p></article>
        <article class="track"><span class="track-index">[ 02 ]</span><h3>机器学习</h3><p>从特征工程到模型评估的实践记录。</p></article>
        <article class="track"><span class="track-index">[ 03 ]</span><h3>深度学习</h3><p>CNN、Transformer 与工程训练流程。</p></article>
        <article class="track"><span class="track-index">[ 04 ]</span><h3>计算机基础</h3><p>课程、系统、网络与编程语言。</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="cta">
        <h2>日拱一卒。<br />让每次输入都有输出。</h2>
        <div class="cta-actions">
          <a class="button" href={withBase('/projects/')}>浏览项目案例 →</a>
          <a class="button" href="https://github.com/mxt1022/algorithmcode" target="_blank" rel="noreferrer">算法代码库 ↗</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .recent-output-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .recent-output-group { min-width: 0; }
  .recent-output-heading { display: grid; grid-template-columns: 1fr auto; gap: 4px 18px; align-items: end; margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .recent-output-heading .eyebrow { grid-column: 1 / -1; }
  .recent-output-heading h3 { margin: 0; font-size: 1.25rem; }
  .recent-output-heading a { color: var(--muted); font-size: .76rem; text-decoration: none; }
  .recent-output-heading a:hover { color: var(--accent); }
  .recent-output-group .post-grid { grid-template-columns: 1fr; }

  @media (max-width: 820px) {
    .recent-output-groups { grid-template-columns: 1fr; gap: 42px; }
  }
</style>
