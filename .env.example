# CloudFlare-ImgBed 应用地址（不含 /upload 或 /file）
IMGBED_API_URL=https://your-imgbed.pages.dev
# 与应用地址相同域名，末尾加 /file；无需填写某张图片的完整链接。
PUBLIC_IMAGE_BASE_URL=https://your-imgbed.pages.dev/file
# 图床后台配置的 Cloudflare R2 渠道名称；只有一个渠道时可留空。
IMGBED_CHANNEL_NAME=
# 在 R2 内保存图片的目录前缀。
R2_PREFIX=blog
# 开启上传认证时填写应用 API Token（upload 权限）或上传认证码。
IMGBED_API_TOKEN=
IMGBED_AUTH_CODE=
